# GEMINI_API_KEY: Optional environment variable provided by AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL Runtime Variables (Object Method - injected by platform)
SQL_HOST="/cloudsql/instance-connection-name"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="your_sql_user_password"

# Cloud SQL PostgreSQL Admin Variables (for Drizzle Kit schema migrations)
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="your_sql_admin_password"

# REQUIRED: High-entropy session signing secret for server-issued HMAC authentication tokens.
# Must be at least 32 characters with >= 10 distinct characters (no default fallback is permitted).
# Generate one via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=""

# OPTIONAL: Outbound webhook URL to deliver single-use password recovery tokens via email provider.
PASSWORD_RESET_WEBHOOK_URL=""
