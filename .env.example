# GEMINI_API_KEY: Optional environment variable provided by AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical HTTPS origin where MedAtlas MCQ is hosted (no path, query, or trailing slash).
APP_URL="https://medatlas.ai.studio"

# Cloud SQL PostgreSQL Runtime Variables (Object Method - injected by platform)
SQL_HOST="/cloudsql/instance-connection-name"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="your_sql_user_password"

# Cloud SQL PostgreSQL Admin Variables (for Drizzle Kit schema migrations)
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="your_sql_admin_password"

# REQUIRED: High-entropy session signing secret for server-issued HMAC authentication tokens.
# Must be at least 32 characters with >= 10 distinct characters (no default fallback is permitted).
# Generate one via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=""

# PASSWORD RECOVERY:
# Handled via Firebase Authentication's built-in email reset-link flow (Identity Toolkit accounts:sendOobCode).
# Configure Firebase Console -> Authentication -> Templates -> Password reset Action URL to:
#   https://medatlas.ai.studio/?mode=resetPassword
# and ensure medatlas.ai.studio (and any preview domains below) are listed in Firebase Authorized Domains.

# OPTIONAL: Comma-separated exact HTTPS origins allowed for password recovery links (no wildcards or paths).
ALLOWED_RECOVERY_ORIGINS="https://medatlas.ai.studio,https://ais-dev-5mhsafvm6orewiuxge6ast-323922691346.europe-west1.run.app,https://ais-pre-5mhsafvm6orewiuxge6ast-323922691346.europe-west1.run.app"

# OPTIONAL: Number of reverse-proxy hops to trust for rate limiting (default: 1 on Cloud Run/production, 0/false when direct).
TRUST_PROXY_HOPS="1"

